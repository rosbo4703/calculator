<!DOCTYPE html>
<html>
<head>
    <title>My Calculator</title>
    <style>
        body {
            font-family: Arial;
            text-align: center;
            margin-top: 80px;
            background: #eeeeee;
        }

        .calculator {
            background: white;
            padding: 20px;
            display: inline-block;
            border-radius: 10px;
        }

        input, button {
            padding: 12px;
            margin: 5px;
            font-size: 16px;
        }

        #result {
            font-size: 22px;
        }
    </style>
</head>
<body>

<div class="calculator">
    <h2>My Calculator</h2>

    <input type="number" id="num1" placeholder="First number">
    <input type="number" id="num2" placeholder="Second number">

    <br>

    <button onclick="calculate('+')">+</button>
    <button onclick="calculate('-')">-</button>
    <button onclick="calculate('*')">×</button>
    <button onclick="calculate('/')">÷</button>

    <p id="result">Result: </p>
</div>

<script>
function calculate(operator) {
    let a = Number(document.getElementById("num1").value);
    let b = Number(document.getElementById("num2").value);
    let answer;

    if (operator === "+") {
        answer = a + b;
    } else if (operator === "-") {
        answer = a - b;
    } else if (operator === "*") {
        answer = a * b;
    } else if (operator === "/") {
        if (b === 0) {
            document.getElementById("result").innerText =
                "Cannot divide by zero";
            return;
        }
        answer = a / b;
    }

    document.getElementById("result").innerText =
        "Result: " + answer;
}
</script>

</body>
</html>
